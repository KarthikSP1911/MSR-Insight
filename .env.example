# ==============================================================================
# MSR-Insight Environment Configuration (Docker Compose)
# ==============================================================================
# By default, docker-compose.yml spins up local Postgres, Redis, and RabbitMQ
# containers. If you wish to use your existing cloud infrastructure (e.g., Neon,
# Upstash, CloudAMQP), simply replace the local URLs below with your cloud URLs
# and you can remove those services from docker-compose.yml if desired.
# ==============================================================================

# ------------------------------------------------------------------------------
# Infrastructure (Local Defaults)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=msr_insight

# To use Neon (Cloud Postgres):
# DATABASE_URL=postgresql://user:pass@neon.tech/dbname
DATABASE_URL=postgresql://postgres:password@postgres:5432/msr_insight

# To use Upstash (Cloud Redis):
# REDIS_URL=rediss://default:password@upstash.io:6379
REDIS_URL=redis://redis:6379

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# To use CloudAMQP:
# RABBITMQ_URL=amqps://user:pass@cloudamqp.com/vhost
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ------------------------------------------------------------------------------
# API Keys (Required for Intelligence Features)
# ------------------------------------------------------------------------------
# Get your keys from:
# - Groq: https://console.groq.com/keys
# - Gemini: https://aistudio.google.com/app/apikey
# - Chroma Cloud: https://trychroma.com (RAG chatbot's vector store -- a
#   separate managed service from Postgres/Neon; create a tenant + database)
# - Resend: https://resend.com/api-keys
# - Cloudinary: https://cloudinary.com/console
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

CHROMA_API_KEY=your_chroma_cloud_api_key_here
CHROMA_TENANT=your_chroma_cloud_tenant_id
CHROMA_DATABASE=your_chroma_cloud_database_name

RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Ollama integration (if running Ollama locally)
OLLAMA_API_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# Agentic AI Chatbot (LangGraph) — independent of the RAG chatbot above
# ------------------------------------------------------------------------------
# Reuses GEMINI_API_KEY. Shared secret so only Express (which verifies the
# proctor's session) is allowed to call FastAPI's /api/agent/* endpoints.
AGENT_LLM_MODEL=gemini-3.1-flash-lite
AGENT_GATEWAY_SECRET=change_me_to_a_long_random_value

# ------------------------------------------------------------------------------
# Admin Panel
# ------------------------------------------------------------------------------
# Shared secret for /api/admin/* routes (admin.routes.js's verifyAdminAccess),
# sent by the frontend as the x-admin-key header. Must match frontend's
# NEXT_PUBLIC_ADMIN_KEY. Change this in any non-local environment.
ADMIN_SECRET_KEY=change_me_to_a_long_random_value
