# Copy-paste reference for overriding load-test config. k6 does not read
# .env files itself -- export these in your shell before running k6/the
# runner, or pass them individually via `k6 run -e VAR=value ...`.
#
#   $env:K6_BASE_URL = "http://localhost:5001"
#   .\run-benchmark.ps1

K6_BASE_URL=http://localhost:5001
K6_PROCTOR_ID=P000
K6_PROCTOR_PASSWORD=password123
K6_STUDENT_USN=1ms23is051
K6_STUDENT_DOB=2004-11-19
K6_SLO_P95_MS=2000
K6_SLO_ERROR_RATE=0.01
