// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  usn           String               @id
  name          String
  dob           String?
  phone         String?
  email         String?
  current_year  Int
  auth_type     String?
  encrypted_pin String?
  details       Json                 // For backward compatibility / performance metrics
  parents       Parent[]
  proctor_maps  ProctorStudentMap[]

  @@map("students")
}

model Proctor {
  proctor_id    String               @id
  name          String
  phone         String?
  email         String?
  password_hash String
  student_maps  ProctorStudentMap[]

  @@map("proctors")
}

model Parent {
  usn      String
  relation String
  name     String
  phone    String
  email    String
  student  Student @relation(fields: [usn], references: [usn])

  @@id([usn, relation])
  @@map("parents")
}

model ProctorStudentMap {
  id            Int     @id @default(autoincrement())
  proctor_id    String
  student_id    String
  academic_year String
  proctor       Proctor @relation(fields: [proctor_id], references: [proctor_id])
  student       Student @relation(fields: [student_id], references: [usn])

  @@unique([student_id, academic_year])
  @@map("proctor_student_map")
}

// ── Agentic AI (LangGraph) tables ──────────────────────────────────────
// Independent of the RAG chatbot. Written to by the FastAPI agent service
// via raw SQL; schema is managed here via Prisma for a single source of truth.

model AgentActionLog {
  id           Int       @id @default(autoincrement())
  proctor_id   String
  thread_id    String
  action_type  String // "send_email" | "send_whatsapp" | "create_reminder" | "risk_analysis" | ...
  status       String // "completed" | "pending_confirmation" | "rejected" | "failed"
  student_usn  String?
  payload      Json
  result       Json?
  created_at   DateTime  @default(now())
  executed_at  DateTime?

  @@map("agent_action_log")
}

model AgentAlert {
  id          Int      @id @default(autoincrement())
  student_usn String
  proctor_id  String
  risk_type   String // "attendance" | "cgpa" | "sgpa_drop"
  severity    String // "low" | "medium" | "high"
  evidence    Json
  message     String
  resolved    Boolean  @default(false)
  created_at  DateTime @default(now())

  @@map("agent_alerts")
}

model AgentReminder {
  id          Int      @id @default(autoincrement())
  proctor_id  String
  student_usn String?
  title       String
  due_date    DateTime
  status      String   @default("pending") // pending | done | dismissed
  created_at  DateTime @default(now())

  @@map("agent_reminders")
}
