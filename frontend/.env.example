# ==============================================================================
# MSR-Insight Frontend Environment Configuration
# ==============================================================================

# Express "Logic Gateway" and FastAPI "Intelligence Service" base URLs.
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# Must match ADMIN_SECRET_KEY in backend/express/.env. Note: NEXT_PUBLIC_*
# vars are bundled into client-side JS and visible to anyone loading the
# page -- this keeps the value out of source control, but the admin panel's
# client-side auth model is not a real security boundary.
NEXT_PUBLIC_ADMIN_KEY=admin123
